# ============================================
# Marqa Souq - Production Environment Variables
# Copy this file to .env and update the values
# ============================================

# ===================
# Database Configuration
# ===================
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://marqa_user:YOUR_STRONG_PASSWORD@localhost:5432/marqa_souq_db

# ===================
# Redis Configuration
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Security Keys (CHANGE THESE!)
# Generate with: openssl rand -base64 48
# ===================
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING_USE_OPENSSL_RAND
COOKIE_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING_USE_OPENSSL_RAND

# ===================
# CORS Configuration
# Update with your actual domain names
# ===================
STORE_CORS=https://marqasouq.com,https://www.marqasouq.com
ADMIN_CORS=https://api.marqasouq.com,https://marqasouq.com
AUTH_CORS=https://marqasouq.com,https://api.marqasouq.com

# ===================
# Backend URL (Public URL of your API)
# ===================
BACKEND_URL=https://api.marqasouq.com

# ===================
# Environment
# ===================
NODE_ENV=production

# ===================
# Optional: File Upload Configuration
# ===================
# ALLOW_VIDEO_UPLOADS=false
# MAX_UPLOAD_SIZE=209715200

# ===================
# Optional: Payment Providers
# ===================
# STRIPE_API_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===================
# Optional: Email Provider (SendGrid)
# ===================
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SENDGRID_FROM=noreply@marqasouq.com

# ===================
# Optional: Odoo Integration
# ===================
# ODOO_URL=https://your-odoo-instance.com
# ODOO_DB=your_odoo_database
# ODOO_USERNAME=your_odoo_username
# ODOO_PASSWORD=your_odoo_password
